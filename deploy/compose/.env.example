# Copy this file to deploy/compose/.env.
# Never commit the real .env.

POSTGRES_DB=video_pose
POSTGRES_USER=video_pose
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# URL-encode special characters in the password used inside this URL.
VIDEO_POSE_DATABASE_URL=postgresql+psycopg://video_pose:CHANGE_ME_URL_ENCODED@postgres:5432/video_pose

VIDEO_POSE_CONFIG_DIR=./runtime
VIDEO_POSE_MODEL_DIR=../../models
VIDEO_POSE_BIND_IP=127.0.0.1
VIDEO_POSE_HTTP_PORT=8080
VIDEO_POSE_QUEUE_SIZE=2

VIDEO_POSE_AUTH_ENABLED=1
# Generate token hashes with: video-pose-auth-hash
VIDEO_POSE_AUTH_TOKENS_JSON=[{"subject":"admin","role":"ADMIN","token_sha256":"CHANGE_ME_64_HEX_SHA256"}]

VIDEO_POSE_DB_MIGRATE=1
VIDEO_POSE_DB_MIGRATION_RETRIES=30
VIDEO_POSE_DB_RECONCILE=1
VIDEO_POSE_RUN_DOCTOR=1
VIDEO_POSE_DOCTOR_SKIP_CUDA=1

# Base image is intentionally site-selectable.
VIDEO_POSE_BASE_IMAGE=ubuntu:24.04
VIDEO_POSE_EXTRAS=api,db,video,yolo,gstreamer-native

# GPU override:
VIDEO_POSE_GPU_BASE_IMAGE=CHANGE_ME_SITE_VALIDATED_NVIDIA_CUDA_IMAGE
VIDEO_POSE_GPU_EXTRAS=api,db,video,yolo,gstreamer-native,mmpose
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
